{
  "name": "Nova",
  "description": "AI小说创作助手",
  "Author": "Shiro狐",
  "version": "0.2.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "node electron/dev.cjs",
    "electron:dev": "npm run desktop:dev",
    "build": "tsc && vite build",
    "desktop:build": "npm run build && electron-builder",
    "electron:build": "npm run desktop:build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.25.0",
    "@tiptap/extension-font-family": "^3.25.0",
    "@tiptap/extension-highlight": "^3.25.0",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/extension-table": "^3.25.0",
    "@tiptap/extension-table-cell": "^3.25.0",
    "@tiptap/extension-table-header": "^3.25.0",
    "@tiptap/extension-table-row": "^3.25.0",
    "@tiptap/extension-task-item": "^3.25.0",
    "@tiptap/extension-task-list": "^3.25.0",
    "@tiptap/extension-text-align": "^3.25.0",
    "@tiptap/extension-text-style": "^3.25.0",
    "@tiptap/extension-underline": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "app-builder-lib": "^26.8.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.novelassistance.app",
    "productName": "Nova",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "output": "release-dev",
      "buildResources": "build"
    }
  }
}
